# Dipakai oleh scripts/import-to-supabase.mjs (jalan di Node, boleh pakai service role key)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...isi-dengan-service-role-key...

# Dipakai oleh aplikasi React/Vite (browser, HARUS pakai anon key, bukan service role)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...isi-dengan-anon-public-key...
